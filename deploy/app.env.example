# Telegram Mini App settings. Copy to /etc/cs2tracker/app.env (chmod 600).

# Bot token from @BotFather.
CS2BOT_TOKEN=
# Public HTTPS address of the Mini App (the reverse proxy below).
CS2BOT_URL=https://cs.example.com/

# Everything below is optional; defaults shown.
# CS2BOT_DB=/var/lib/cs2tracker/cs2tracker.db
# CS2BOT_HOST=127.0.0.1
# CS2BOT_PORT=8080
# Currency for all prices. For price=buy it must be the currency Steam uses for the server's IP.
# CS2BOT_CURRENCY=UAH
# sell = lowest listing ("Starting at"), buy = highest buy order.
# CS2BOT_PRICE=sell
# CS2BOT_REFRESH_MINUTES=10
# CS2BOT_REQUEST_DELAY=1.5
# Comma-separated Telegram user ids; empty = anyone who finds the bot.
# CS2BOT_ALLOWED_USERS=
# CS2BOT_MAX_ITEMS=200
# Comma-separated Telegram user ids that see the usage statistics (link at the bottom of Home).
# CS2BOT_ADMINS=
